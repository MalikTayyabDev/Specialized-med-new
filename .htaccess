Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# ---------------------------------------------------------------------------
# Canonical URL form is the .html page (e.g. /about.html), as served by this
# Apache host. Every redirect below goes straight to the final
# https://www. URL so there is never more than one hop.
# ---------------------------------------------------------------------------

# /index.html -> / (THE_REQUEST guard avoids looping on the DirectoryIndex subrequest)
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/index\.html[\s?]
RewriteRule ^index\.html$ https://www.specialized-med.com/ [R=301,L]

# Legacy .jsp URLs
RewriteRule ^index\.jsp$    https://www.specialized-med.com/ [R=301,L]
RewriteRule ^about\.jsp$    https://www.specialized-med.com/about.html [R=301,L]
RewriteRule ^services\.jsp$ https://www.specialized-med.com/services.html [R=301,L]
RewriteRule ^faq\.jsp$      https://www.specialized-med.com/faq.html [R=301,L]
RewriteRule ^contact\.jsp$  https://www.specialized-med.com/contact.html [R=301,L]

# Trailing-slash and extensionless URLs -> canonical .html pages
RewriteRule ^about/?$                                  https://www.specialized-med.com/about.html [R=301,L]
RewriteRule ^services/?$                               https://www.specialized-med.com/services.html [R=301,L]
RewriteRule ^services/equipment/?$                     https://www.specialized-med.com/services/equipment.html [R=301,L]
RewriteRule ^faq/?$                                    https://www.specialized-med.com/faq.html [R=301,L]
RewriteRule ^contact/?$                                https://www.specialized-med.com/contact.html [R=301,L]
RewriteRule ^clinical-stories/?$                       https://www.specialized-med.com/clinical-stories.html [R=301,L]
RewriteRule ^privacy/?$                                https://www.specialized-med.com/privacy.html [R=301,L]
RewriteRule ^thanks/?$                                 https://www.specialized-med.com/thanks.html [R=301,L]
RewriteRule ^mobile-cardiac-telemetry-mct/?$           https://www.specialized-med.com/mobile-cardiac-telemetry-mct.html [R=301,L]
RewriteRule ^post-tavr-cardiac-monitoring/?$           https://www.specialized-med.com/post-tavr-cardiac-monitoring.html [R=301,L]
RewriteRule ^holter-monitoring-services/?$             https://www.specialized-med.com/holter-monitoring-services.html [R=301,L]
RewriteRule ^long-term-holter-monitoring/?$            https://www.specialized-med.com/long-term-holter-monitoring.html [R=301,L]
RewriteRule ^cardiac-event-monitoring/?$               https://www.specialized-med.com/cardiac-event-monitoring.html [R=301,L]
RewriteRule ^live-ecg-monitoring/?$                    https://www.specialized-med.com/live-ecg-monitoring.html [R=301,L]
RewriteRule ^s-patch-cardiac-monitoring-system/?$      https://www.specialized-med.com/s-patch-cardiac-monitoring-system.html [R=301,L]
RewriteRule ^cardiac-monitoring-services/?$            https://www.specialized-med.com/cardiac-monitoring-services.html [R=301,L]
RewriteRule ^ambulatory-cardiac-monitoring/?$          https://www.specialized-med.com/ambulatory-cardiac-monitoring.html [R=301,L]
RewriteRule ^cardiology-practice-cardiac-monitoring/?$ https://www.specialized-med.com/cardiology-practice-cardiac-monitoring.html [R=301,L]

# Force HTTPS + www in a single hop
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^specialized-med\.com$ [NC]
RewriteRule ^(.*)$ https://www.specialized-med.com/$1 [R=301,L]

ErrorDocument 404 /404.html

Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Redirect legacy .jsp URLs first (before any other rules)
RewriteRule ^index\.jsp$    / [R=301,L]
RewriteRule ^about\.jsp$    /about.html [R=301,L]
RewriteRule ^services\.jsp$ /services.html [R=301,L]
RewriteRule ^faq\.jsp$      /faq.html [R=301,L]
RewriteRule ^contact\.jsp$  /contact.html [R=301,L]

# Pretty URL: MCT landing (canonical with trailing slash per PDF Stage 3.1)
RewriteRule ^mobile-cardiac-telemetry-mct\.html$ /mobile-cardiac-telemetry-mct/ [R=301,L]
RewriteRule ^mobile-cardiac-telemetry-mct$ /mobile-cardiac-telemetry-mct/ [R=301,L]
RewriteRule ^mobile-cardiac-telemetry-mct/$ /mobile-cardiac-telemetry-mct.html [L]
RewriteRule ^post-tavr-cardiac-monitoring\.html$ /post-tavr-cardiac-monitoring/ [R=301,L]
RewriteRule ^post-tavr-cardiac-monitoring/?$ /post-tavr-cardiac-monitoring.html [L]
RewriteRule ^privacy\.html$ /privacy/ [R=301,L]
RewriteRule ^privacy/?$ /privacy.html [L]

# Pretty URLs: related modality landings (PDF Stage 3.6 link cluster)
RewriteRule ^holter-monitoring-services\.html$ /holter-monitoring-services/ [R=301,L]
RewriteRule ^holter-monitoring-services/?$ /holter-monitoring-services.html [L]
RewriteRule ^long-term-holter-monitoring\.html$ /long-term-holter-monitoring/ [R=301,L]
RewriteRule ^long-term-holter-monitoring/?$ /long-term-holter-monitoring.html [L]
RewriteRule ^cardiac-event-monitoring\.html$ /cardiac-event-monitoring/ [R=301,L]
RewriteRule ^cardiac-event-monitoring/?$ /cardiac-event-monitoring.html [L]
RewriteRule ^live-ecg-monitoring\.html$ /live-ecg-monitoring/ [R=301,L]
RewriteRule ^live-ecg-monitoring/?$ /live-ecg-monitoring.html [L]
RewriteRule ^s-patch-cardiac-monitoring-system\.html$ /s-patch-cardiac-monitoring-system/ [R=301,L]
RewriteRule ^s-patch-cardiac-monitoring-system/?$ /s-patch-cardiac-monitoring-system.html [L]

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force www
RewriteCond %{HTTP_HOST} ^specialized-med\.com [NC]
RewriteRule ^(.*)$ https://www.specialized-med.com/$1 [L,R=301]


# Staging / pre-launch: noindex MCT until Stage 7 gate (managed by flip-mct-indexability.mjs)
<IfModule mod_headers.c>
  <Files "mobile-cardiac-telemetry-mct.html">
    Header set X-Robots-Tag "noindex, nofollow"
  </Files>
</IfModule>

ErrorDocument 404 /404.html

{
  "name": "specialized-medical-static-site",
  "private": true,
  "description": "Build shim for Netlify when base=static-site.",
  "scripts": {
    "dev": "node scripts/local-dev-server.mjs",
    "build": "node scripts/prepare-netlify-publish-dir.mjs",
    "build:mct": "node scripts/build-mct-landing-html.mjs",
    "build:chrome": "node scripts/build-chrome-css.mjs",
    "build:landing-mct": "node scripts/build-landing-mct-css.mjs",
    "mct:index": "node scripts/flip-mct-indexability.mjs index",
    "mct:noindex": "node scripts/flip-mct-indexability.mjs noindex",
    "qa:mct": "node scripts/qa-mct-pdf.mjs",
    "cache-bust": "node scripts/cache-bust.mjs",
    "cache-bust:check": "node scripts/cache-bust.mjs --check",
    "build:tomcat-filter": "javac --release 8 -cp \"$SERVLET_API_JAR\" -d WEB-INF/classes WEB-INF/src/com/specializedmedical/web/*.java",
    "seo:noindex": "node scripts/set-indexing.mjs noindex",
    "seo:index": "node scripts/set-indexing.mjs index",
    "seo:status": "node scripts/set-indexing.mjs status"
  }
}
